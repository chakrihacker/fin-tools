---
import { ModeToggle } from "../ModeToggle";
import { LanguageSelector } from "../LanguageSelector";

const currentPath = Astro.url.pathname;
---

<header
  transition:persist
  class="w-full backdrop-blur-md border-b border-neutral-200/50 dark:border-neutral-800/50 flex flex-row items-center px-4 py-3 lg:sticky lg:top-0 lg:z-50"
>
  <div
    class="max-w-4xl w-full mx-auto flex flex-row items-center justify-between gap-4"
  >
    <!-- Brand -->
    <a
      href="/"
      class="text-xl font-bold text-neutral-800 dark:text-neutral-200 hover:opacity-80 transition-opacity shrink-0"
    >
      Fin Tools
    </a>

    <!-- Navigation -->
    <nav class="hidden sm:flex items-center gap-1">
      <a
        href="/"
        class:list={[
          "px-3 py-1.5 rounded-md text-sm font-medium transition-colors",
          currentPath === "/"
            ? "bg-neutral-900/10 dark:bg-neutral-100/10 text-neutral-900 dark:text-neutral-100"
            : "text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 hover:bg-neutral-900/5 dark:hover:bg-neutral-100/5",
        ]}
      >
        Home
      </a>
      <a
        href="/vaddi"
        class:list={[
          "px-3 py-1.5 rounded-md text-sm font-medium transition-colors",
          currentPath === "/vaddi"
            ? "bg-neutral-900/10 dark:bg-neutral-100/10 text-neutral-900 dark:text-neutral-100"
            : "text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 hover:bg-neutral-900/5 dark:hover:bg-neutral-100/5",
        ]}
      >
        Interest Calculator
      </a>
      <a
        href="/stock-average"
        class:list={[
          "px-3 py-1.5 rounded-md text-sm font-medium transition-colors",
          currentPath === "/stock-average"
            ? "bg-neutral-900/10 dark:bg-neutral-100/10 text-neutral-900 dark:text-neutral-100"
            : "text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 hover:bg-neutral-900/5 dark:hover:bg-neutral-100/5",
        ]}
      >
        Stock Average
      </a>
    </nav>

    <!-- Controls -->
    <div class="flex items-center gap-2">
      <LanguageSelector client:load />
      <ModeToggle client:load />
    </div>
  </div>
</header>
