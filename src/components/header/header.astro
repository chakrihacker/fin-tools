---
import { ModeToggle } from "../ModeToggle";
import { LanguageSelector } from "../LanguageSelector";
import { MobileNavigation } from "../MobileNavigation";

const currentPath = Astro.url.pathname;
---

<header
  transition:persist
  class="w-full border-b border-border bg-background/80 backdrop-blur-md flex flex-row items-center px-4 py-3 lg:sticky lg:top-0 lg:z-50"
>
  <div
    class="max-w-4xl w-full mx-auto flex flex-row items-center justify-between gap-4"
  >
    <!-- Brand -->
    <a
      href="/"
      class="text-xl font-bold text-foreground hover:opacity-80 transition-opacity shrink-0"
    >
      Fin Tools
    </a>

    <!-- Navigation -->
    <nav class="hidden sm:flex items-center gap-1">
      <a
        href="/"
        class:list={[
          "px-3 py-1.5 rounded-md text-sm font-medium transition-colors",
          currentPath === "/"
            ? "bg-accent text-accent-foreground"
            : "text-muted-foreground hover:bg-accent hover:text-accent-foreground",
        ]}
      >
        Home
      </a>
      <a
        href="/vaddi"
        class:list={[
          "px-3 py-1.5 rounded-md text-sm font-medium transition-colors",
          currentPath === "/vaddi"
            ? "bg-accent text-accent-foreground"
            : "text-muted-foreground hover:bg-accent hover:text-accent-foreground",
        ]}
      >
        Interest Calculator
      </a>
      <a
        href="/stock-average"
        class:list={[
          "px-3 py-1.5 rounded-md text-sm font-medium transition-colors",
          currentPath === "/stock-average"
            ? "bg-accent text-accent-foreground"
            : "text-muted-foreground hover:bg-accent hover:text-accent-foreground",
        ]}
      >
        Stock Average
      </a>
      <a
        href="/profit-booking"
        class:list={[
          "px-3 py-1.5 rounded-md text-sm font-medium transition-colors",
          currentPath === "/profit-booking"
            ? "bg-accent text-accent-foreground"
            : "text-muted-foreground hover:bg-accent hover:text-accent-foreground",
        ]}
      >
        Profit Booking
      </a>
    </nav>

    <!-- Controls -->
    <div class="flex items-center gap-2">
      <div class="sm:hidden">
        <MobileNavigation client:load currentPath={currentPath} />
      </div>
      <LanguageSelector client:load />
      <ModeToggle client:load />
    </div>
  </div>
</header>
