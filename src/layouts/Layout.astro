---
import Header from "@/components/header/header.astro";
import { MobileNavigation } from "@/components/MobileNavigation";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Fin Tools",
	description = "Simple, powerful tools for your everyday financial calculations",
} = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body
		class="flex min-h-screen flex-col bg-background text-foreground selection:bg-primary selection:text-primary-foreground"
	>
		<Header />
		<main class="flex-1 px-4 py-6 pb-28 lg:px-0 lg:pb-6">
			<div class="w-full">
				<slot />
			</div>
		</main>
		<MobileNavigation client:load currentPath={currentPath} />
	</body>
</html>
