---
import "@/styles/globals.css";
import ProfitBookingCalculator from "@/containers/profit-booking-calculator";
import Layout from "@/layouts/Layout.astro";
---

<script is:inline>
	const getThemePreference = () => {
		if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
			return localStorage.getItem("theme");
		}
		return window.matchMedia("(prefers-color-scheme: dark)").matches
			? "dark"
			: "light";
	};
	const isDark = getThemePreference() === "dark";
	document.documentElement.classList[isDark ? "add" : "remove"]("dark");

	if (typeof localStorage !== "undefined") {
		const observer = new MutationObserver(() => {
			const isDark = document.documentElement.classList.contains("dark");
			localStorage.setItem("theme", isDark ? "dark" : "light");
		});
		observer.observe(document.documentElement, {
			attributes: true,
			attributeFilter: ["class"],
		});
	}
</script>

<Layout
	title="Profit Booking Calculator - Fin Tools"
	description="Calculate how many shares to sell to recover your capital and hold the remaining profit."
>
	<div class="max-w-2xl mx-auto px-4 py-8">
		<ProfitBookingCalculator client:load />
	</div>
</Layout>